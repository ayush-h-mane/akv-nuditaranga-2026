# ========================================================
# AKV NUDITARANGA 2026 - ENVIRONMENT CONFIGURATION TEMPLATE
# ========================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# DO NOT COMMIT ACTUAL PASSWORDS OR SECRETS TO GIT.

# --------------------------------------------------------
# 1. DATABASE CONFIGURATION
# --------------------------------------------------------
# Local Development (SQLite):
DATABASE_URL="sqlite:///./akv_fest.db"

# Production (PostgreSQL - e.g. Supabase, Neon, AWS RDS):
# Required in production. Do NOT use SQLite on Vercel.
# Example: postgresql://postgres.xxxx:your-password@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?sslmode=require
# DATABASE_URL="postgresql://username:password@host:5432/dbname?sslmode=require"

# --------------------------------------------------------
# 2. JWT & AUTHENTICATION SECRETS
# --------------------------------------------------------
# Provide a 64-character cryptographically secure random string in production
# Generate via: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="replace-with-secure-random-secret"
JWT_SECRET="replace-with-secure-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --------------------------------------------------------
# 3. INITIAL SUPERADMIN CREDENTIALS
# --------------------------------------------------------
# Configured securely on backend server startup (never exposed to browser)
SUPERADMIN_USERNAME="replace-with-admin-username"
SUPERADMIN_PASSWORD="replace-with-secure-admin-password"
SUPERADMIN_EMAIL="kannadavedike@acharya.ac.in"
SUPERADMIN_NAME="AKV Super Administrator"

# --------------------------------------------------------
# 4. CORS & DOMAIN CONFIGURATION
# --------------------------------------------------------
# Frontend domain used for CORS headers and password reset links
FRONTEND_URL="http://localhost:5173"
ALLOWED_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,https://your-production-domain.vercel.app"

# --------------------------------------------------------
# 5. SMTP EMAIL CONFIGURATION (OPTIONAL / PASSWORD RESET)
# --------------------------------------------------------
# Leave empty for mock/console output in development
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USERNAME=""
SMTP_PASSWORD=""
EMAIL_FROM="kannadavedike@acharya.ac.in"
EMAIL_FROM_NAME="Acharya Kannada Vedike - Nuditaranga 2026"
